# Local development configuration
ENVIRONMENT=
DATABASE_URL=
DEFAULT_CURRENCY=

# Optional AI credentials. Leave blank to use deterministic fallbacks.
TINKER_API_KEY=
BACKBOARD_API_KEY=

# Authentication and private-workspace configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
CORS_ORIGINS=

# Supabase email delivery and the 5/hour rate limit are configured in:
# Supabase Dashboard -> Authentication -> SMTP Settings / Rate Limits.
# Do not store SMTP credentials in this application .env file.

# Optional trained model configuration
TINKER_MODEL_PATH=
TABPFN_ENABLED=
